{
  "bridgeRootDir": "D:\\mcp\\xshell-mcp-bridge",
  "defaultSessionId": "default",
  "sessionLabels": {},
  "sessionStaleAfterMs": 30000,
  "statusCacheTtlMs": 1000,
  "pollMs": 30,
  "transport": "stdio",
  "httpPort": 8765,
  "dangerousCommands": {
    "builtinRulesEnabled": true,
    "blockedPatterns": [
      "\\bcurl\\b.*\\|\\s*(sh|bash)\\b",
      "\\bwget\\b.*\\|\\s*(sh|bash)\\b"
    ],
    "blockedLiterals": [
      "rm -rf /",
      "format c:"
    ]
  }
}
